# Database
DATABASE_URL=postgresql://pepuser:peppass@localhost:5432/pep_compliance

# AI Providers
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o

# Web Scraping
XACXOM_SEARCH_URL=https://xacxom.iaac.mn/xacxom/search

# Authentication
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRY_HOURS=24

# Background Tasks (Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Application
APP_COMPANY_COUNTRY_CODE=MN
APP_DEBUG=false
APP_LOG_LEVEL=INFO
